#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer RgbHistogram {
    uint bins[];
} histogram;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D blacklevelImage;

layout(push_constant) uniform PushConstants {
    uint sourceWidth;
    uint sourceHeight;
    float brightness;
} pc;

const uint WF_WIDTH = 580;
const uint WF_HEIGHT = 256;

void main() {
    const uvec2 xy = gl_GlobalInvocationID.xy;
    if (xy.x >= WF_WIDTH || xy.y >= WF_HEIGHT) {
        return;
    }

    const uint sourceBin = min(uint(floor(float(WF_HEIGHT - 1u - xy.y) * 0.137255)), 255u);
    const uint baseIndex = (sourceBin * WF_WIDTH + xy.x) * 3u;
    const vec3 counts = vec3(
        histogram.bins[baseIndex + 0u],
        histogram.bins[baseIndex + 1u],
        histogram.bins[baseIndex + 2u]);
    const vec3 rgb = clamp(counts * pc.brightness / 255.0, vec3(0.0), vec3(1.0));
    imageStore(blacklevelImage, ivec2(xy), vec4(rgb, 1.0));
}
