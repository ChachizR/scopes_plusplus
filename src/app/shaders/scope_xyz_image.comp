#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer XyzHistogram {
    uint bins[];
} histogram;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D scopeImage;

layout(push_constant) uniform PushConstants {
    uint sourceWidth;
    uint sourceHeight;
    float brightness;
} pc;

const uint SC_WIDTH = 256;
const uint SC_HEIGHT = 256;

float oetf_BT709(float value) {
    return (value <= 0.018) ? (value * 4.5) : (1.099 * pow(max(value, 0.0), 0.45) - 0.099);
}

vec3 oetf_BT709_3(vec3 value) {
    return vec3(oetf_BT709(value.r), oetf_BT709(value.g), oetf_BT709(value.b));
}

vec3 XYZ_to_linearRGB709(vec3 xyz) {
    return mat3(
        3.24096990, -0.96924365, 0.05563009,
        -1.53738320, 1.87596750, -0.20397697,
        -0.49861076, 0.04155505, 1.05697155) * xyz;
}

vec3 xy_to_RGB709(float x, float y, float Y) {
    if (y <= 0.0 || x <= 0.0 || y >= 1.0 || x + y >= 1.0) {
        return vec3(0.0);
    }

    const float X = (x / y) * Y;
    const float Z = ((1.0 - x - y) / y) * Y;
    return oetf_BT709_3(max(XYZ_to_linearRGB709(vec3(X, Y, Z)), vec3(0.0)));
}

void main() {
    const uvec2 xy = gl_GlobalInvocationID.xy;
    if (xy.x >= SC_WIDTH || xy.y >= SC_HEIGHT) {
        return;
    }

    const uint count = histogram.bins[xy.y * SC_WIDTH + xy.x];
    const float intensity = clamp(float(count) * pc.brightness / 255.0, 0.0, 1.0);
    const float cieX = float(xy.x) / 255.0;
    const float cieY = 1.0 - float(xy.y) / 255.0;
    const vec3 tint = clamp(xy_to_RGB709(cieX, cieY, 0.5), vec3(0.0), vec3(1.0));
    imageStore(scopeImage, ivec2(xy), vec4(tint * intensity, 1.0));
}
