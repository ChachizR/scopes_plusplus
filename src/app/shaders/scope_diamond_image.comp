#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer DiamondHistogram {
    uint bins[];
} histogram;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D scopeImage;

layout(push_constant) uniform PushConstants {
    uint sourceWidth;
    uint sourceHeight;
    float brightness;
} pc;

const uint SC_WIDTH = 256;
const uint SC_HEIGHT = 256;

void main() {
    const uvec2 xy = gl_GlobalInvocationID.xy;
    if (xy.x >= SC_WIDTH || xy.y >= SC_HEIGHT) {
        return;
    }

    const uint count = histogram.bins[xy.y * SC_WIDTH + xy.x];
    const float intensity = clamp(float(count) * pc.brightness / 255.0, 0.0, 1.0);
    const vec2 norm = vec2(float(xy.x) / 255.0, 1.0 - float(xy.y) / 255.0);

    vec3 tint;
    if (norm.y <= 0.5) {
        tint = vec3(0.0, 1.5 - norm.x - 2.0 * norm.y, 0.5 + norm.x - 2.0 * norm.y);
    } else {
        tint = vec3(norm.x + 2.0 * norm.y - 1.5, 2.0 * norm.y - norm.x - 0.5, 0.0);
    }

    imageStore(scopeImage, ivec2(xy), vec4(clamp(tint, vec3(0.0), vec3(1.0)) * intensity, 1.0));
}
