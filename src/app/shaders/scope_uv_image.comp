#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer UvHistogram {
    uint bins[];
} histogram;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D scopeImage;

layout(push_constant) uniform PushConstants {
    uint sourceWidth;
    uint sourceHeight;
    float brightness;
} pc;

const uint SC_WIDTH = 256;
const uint SC_HEIGHT = 256;

vec3 yuv_709_limited_to_rgb_709(vec3 yuv) {
    const vec3 offset = vec3(16.0 / 255.0, 128.0 / 255.0, 128.0 / 255.0);
    return mat3(
        1.16438356, 1.16438356, 1.16438356,
        0.00000000, -0.21324861, 2.11240172,
        1.79274107, -0.53290933, 0.00000000) * (yuv - offset);
}

void main() {
    const uvec2 xy = gl_GlobalInvocationID.xy;
    if (xy.x >= SC_WIDTH || xy.y >= SC_HEIGHT) {
        return;
    }

    const uint count = histogram.bins[xy.y * SC_WIDTH + xy.x];
    const float intensity = clamp(float(count) * pc.brightness / 255.0, 0.0, 1.0);
    const vec3 tint = clamp(yuv_709_limited_to_rgb_709(vec3(0.5, float(xy.x) / 255.0, float(SC_HEIGHT - xy.y) / 255.0)), vec3(0.0), vec3(1.0));
    imageStore(scopeImage, ivec2(xy), vec4(tint * intensity, 1.0));
}
